# Copie de nginx.conf avec une seule différence : l'adresse du backend
# vient de variables d'environnement au lieu d'être écrite en dur.
# Cela permettra de réutiliser la même image sur Azure Container Apps.
# Les variables d'Nginx comme $host restent intactes : seules les variables
# d'environnement définies sont remplacées.

upstream backend {
    least_conn;
    server ${BACKEND_HOST}:${BACKEND_PORT};
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;

    # Application principale.
    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Page d'administration.
    location = /gestion-quiz {
        try_files /gestion-quiz.html =404;
    }

    # Proxy de l'API vers le backend.
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Test de santé, transmis au backend.
    location /health {
        proxy_pass http://backend;
        proxy_http_version 1.1;
    }
}
